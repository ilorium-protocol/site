---
import Base from '../layouts/Base.astro';
---
<Base title="Not found — Ilorium" noindex>
  <section class="sec dk" style="border-top:0;min-height:50vh">
    <div class="wrap" style="display:flex;flex-direction:column;gap:16px">
      <p class="lab dim">[ 404 ]</p>
      <h1 class="disp h1" style="font-size:clamp(38px,5.6vw,68px)">Not observed.</h1>
      <p class="lead">There is nothing at this address. What we could not see is drawn, never hidden.</p>
      <p><a class="btn b1 cut" href="/">Back to the start</a></p>
    </div>
  </section>
</Base>
